# Cloudinary keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="callejeandola"

EMAIL_PROVIDER=resend
RESEND_API_KEY=""
